# apache/spark:4.1.3 ships hadoop-client 3.4.2 but neither the S3A connector
# nor spark-hadoop-cloud, whose commit protocol lets Spark SQL use the S3A
# committers. Bake both in, pinned to the versions spark-hadoop-cloud 4.1.3
# resolves to: hadoop-aws 3.4.2 with AWS SDK v2 2.29.52.
FROM apache/spark:4.1.3

ARG MAVEN_REPO=https://repo1.maven.org/maven2

USER root
RUN set -eux; \
    cd /opt/spark/jars; \
    fetch() { \
        curl -fsSL --retry 5 --retry-delay 3 -o "$(basename "$2")" "$MAVEN_REPO/$2"; \
        echo "$1  $(basename "$2")" | sha256sum -c -; \
    }; \
    fetch d2d24e6b715b5656b9d238bf13b6682a07e2004dd36aad74a73aeb854319f4d9 \
        org/apache/hadoop/hadoop-aws/3.4.2/hadoop-aws-3.4.2.jar; \
    fetch 62638f33045690c6bc5e496b54b0b2e89a9ad38cbedacdf6e017fea6bc85f55c \
        software/amazon/awssdk/bundle/2.29.52/bundle-2.29.52.jar; \
    fetch 678961ff984143a59b80d136ad8a79bec21e2b4664e3eb96a0369d9adcc38af9 \
        software/amazon/s3/analyticsaccelerator/analyticsaccelerator-s3/1.3.0/analyticsaccelerator-s3-1.3.0.jar; \
    fetch 4e74acb300c9032073d7f4ba1d5b9d342648dd0bedeeb4c60e89c13be378c36d \
        org/apache/spark/spark-hadoop-cloud_2.13/4.1.3/spark-hadoop-cloud_2.13-4.1.3.jar
USER spark
